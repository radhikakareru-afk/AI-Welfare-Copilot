# ==============================================================================
# AI WELFARE COPILOT - BACKEND ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to .env and configure the parameters for your environment.
# DO NOT COMMIT SENSITIVE PASSWORDS OR API KEYS TO VERSION CONTROL.
# ==============================================================================

# Core Express Server
PORT=5000

# PostgreSQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=AI-Welfare-Copilot
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# ------------------------------------------------------------------------------
# AUTOMATIC SCHEME SYNCHRONIZATION CONFIGURATION
# ------------------------------------------------------------------------------

# Daily cron schedule (default: 02:00 AM every day)
# Standard 5-field cron format: minute hour day-of-month month day-of-week
SYNC_CRON_SCHEDULE=0 2 * * *

# Enable or disable automatic daily background synchronization (true | false)
SYNC_AUTO_ENABLED=true

# ------------------------------------------------------------------------------
# OFFICIAL GOVERNMENT API GATEWAYS (OPTIONAL / CREDENTIALS REQUIRED)
# ------------------------------------------------------------------------------

# 1. Open Government Data (OGD) Platform India (data.gov.in)
# Register at: https://data.gov.in/
# Required for automated machine-readable dataset ingestion.
DATA_GOV_IN_API_KEY=

# 2. MahaDBT State Welfare Platform (Government of Maharashtra)
# Portal: https://mahadbt.maharashtra.gov.in
# Access requires official Government of Maharashtra departmental authorization & MoU.
MAHADBT_API_KEY=
MAHADBT_API_ENDPOINT=

# 3. MyScheme National Platform (MeitY & NeGD)
# Portal: https://www.myscheme.gov.in
# Access requires institutional onboarding with the National e-Governance Division (NeGD).
MYSCHEME_API_KEY=
MYSCHEME_API_ENDPOINT=
