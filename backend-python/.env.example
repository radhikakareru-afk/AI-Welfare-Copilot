# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=AI-Welfare-Copilot
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# Flask Server Configuration
FLASK_PORT=5001
FLASK_DEBUG=True
SECRET_KEY=change_this_to_a_secure_random_string_in_production
FRONTEND_URL=http://localhost:5173

# Gmail SMTP Configuration for Email OTP Verification
# Use a 16-character App Password generated from Google Account > Security > 2-Step Verification > App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_APP_PASSWORD=your_gmail_app_password

# OTP Delivery Mode Configuration
# Options: 'local_demo' (prints OTP in Flask terminal only) or 'email' (sends real email via Gmail SMTP)
# Note: 'local_demo' is strictly rejected in production environments.
OTP_MODE=email

# OTP Policy Configuration
OTP_EXPIRY_MINUTES=5
RESEND_COOLDOWN_SECONDS=60
MAX_OTP_ATTEMPTS=5
